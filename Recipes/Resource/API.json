/api/users/set - установка параметров пользователя
-> {
    "goal": 1,
    "categories": [1, 2],
    "quantity": 1,
    "pace": 2,
    "time": 10,
    "notification_key": "adadoasdosfvdjvnewve",
    "notification_options": [1],
    "diets_id": [1]
}

<- {
    "success": true
}

